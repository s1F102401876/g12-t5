# SafeCare-AI 環境変数設定例
# このファイルをコピーして .env ファイルを作成してください

# ===== バックエンド設定 =====

# サーバー設定
HOST=0.0.0.0
PORT=8000

# モデル設定
MODEL_NAME=melihuzunoglu/human-fall-detection
MODEL_PATH=./models/human-fall-detection/best.pt
CONFIDENCE_THRESHOLD=0.5

# 判定安定化ロジック
BUFFER_SIZE=10
FALL_THRESHOLD=7

# カメラ設定
TARGET_FPS=15
FRAME_WIDTH=640
FRAME_HEIGHT=640

# データベース設定
DATABASE_PATH=./data/safecare.db

# ===== フロントエンド設定 =====

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ログレベル
NEXT_PUBLIC_LOG_LEVEL=INFO

# ===== セキュリティ設定 =====

# CORS許可オリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:3000

# レート制限（リクエスト/分）
RATE_LIMIT=60

# ===== プライバシー設定 =====

# 顔ぼかし有効化
FACE_BLURRING=true

# データ保存期間（日数）
DATA_RETENTION_DAYS=30

# 外部データ送信許可
ALLOW_EXTERNAL_TRANSMISSION=false
